# Frontend build-time configuration (VITE_ prefix is required by Vite).
# NEVER put secrets here — anything in VITE_* is bundled into the public JS.

# Render backend API origin for the SPLIT deployment.
# Leave EMPTY for same-origin setups (dev Vite proxy handles /api automatically).
# Example: VITE_API_BASE=https://bilbilash-api.onrender.com
VITE_API_BASE=
