# BILBILASH ALUMNI — environment template
# The application reads environment variables from backend/.env (local) or the
# Render / Vercel dashboards (production). Copy backend/.env.example to
# backend/.env and fill in REAL values. Never commit .env.

# Backend (see backend/.env.example for the full annotated list):
DATABASE_URL=            # Supabase PostgreSQL connection string (or DB_* for local dev)
JWT_SECRET=              # long random secret
PORT=5000
CORS_ORIGINS=            # deployed Vercel URL(s), comma-separated
AUTHORITY_EMAIL=
AUTHORITY_PASSWORD=

# Frontend (frontend/.env — build-time, NEVER any secret):
# VITE_API_BASE=         # deployed Render API URL, e.g. https://bilbilash-api.onrender.com
