[TEMPLATE]
# BILBILASH ALUMNI — backend environment template (PostgreSQL)
# Copy to ".env" (inside backend/) and fill REAL values. Never commit .env.

# ── Database (PostgreSQL — Supabase in production) ────────────────────────────
# Production: the full connection URI from Supabase (Settings → Database →
# Connection string → URI). On Render use the POOLER (pgbouncer) URI —
# direct connections time out under connection pooling.
#   postgresql://postgres.YOUR_PROJECT:[PASSWORD]@aws-0-…pooler.supabase.com:6543/postgres
# sslmode is honored from the URL (Supabase requires sslmode=require).
DATABASE_URL=

# Local development alternative — used ONLY when DATABASE_URL is empty
# (e.g. a local PostgreSQL or the embedded dev server on port 55432).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bilbilash_alumni
# Set to "true" when the DB_* server requires TLS
DB_SSL=

# ── Server ───────────────────────────────────────────────────────────────────
# Render sets PORT automatically; the app reads process.env.PORT.
PORT=5000
# Long random string (e.g. `openssl rand -hex 64`). Rotate before public launch.
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
# Comma-separated allowed browser origins — the DEPLOYED Vercel URL in
# production, e.g. https://bilbilash-alumni.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Seed accounts ────────────────────────────────────────────────────────────
AUTHORITY_EMAIL=
AUTHORITY_PASSWORD=

# ── Email: password-reset OTP delivery ───────────────────────────────────────
# PRODUCTION (Render): SMTP ports 25/465/587 are BLOCKED for Free web
# services (render.com/docs/free), so delivery uses an email provider HTTPS API
# on port 443. Pick ONE provider and set all three:
#   EMAIL_PROVIDER=resend   (recommended — 100 emails/day, 3000/month free)
#   EMAIL_PROVIDER=brevo    (300 emails/day free)
#   EMAIL_PROVIDER=sendgrid (60-day trial, 100/day — not a permanent free tier)
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Verified sender shown in the inbox ("Name <no-reply@yourdomain>" or a bare
# address). Must be a verified/confirmed sender in the provider dashboard.
EMAIL_FROM=
# TEST-ONLY override of the provider API host; NEVER set in production.
#EMAIL_PROVIDER_BASE_URL=
# Per-attempt provider API timeout in ms (default 8000).
#EMAIL_PROVIDER_TIMEOUT_MS=

# LOCAL-DEV transport (used only when EMAIL_PROVIDER is empty): Gmail SMTP.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Dev-only escape hatch (OTP echoed to the API response when SMTP is unset).
# NEVER set this to 1 in production.
ALLOW_DEV_OTP=

# ── Upload storage: Supabase Storage (production) ────────────────────────────
# Both values are SERVER-ONLY secrets — Render dashboard / backend/.env ONLY.
# NEVER put them in Vercel, in any VITE_ variable, in code, or in Git.
# With these set the upload driver becomes 'supabase' automatically.
# Buckets (create once, keep PUBLIC for image viewing — uploads still go only
# through this backend with the service key, so a public bucket permits no
# anonymous writes):
#   profile-images  — member + teacher photos (1 MB limit)
#   gallery-images  — alumni gallery photos (3 MB limit)
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit driver override: local | supabase | cloudinary
UPLOAD_STORAGE=
# Cloudinary remains an alternative driver (unused when SUPABASE_* is set):
CLOUDINARY_URL=

# ── Mobile-money receiving numbers (manual payment verification) ─────────────
# Real Bangladeshi wallet numbers, 11 digits starting 01. Unset = UI shows a
# setup notice instead of a placeholder number.
BKASH_NUMBER=
NAGAD_NUMBER=
ROCKET_NUMBER=
